# Compile-only component selection; runtime permissions remain closed.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_MTK_SND_SOC_NEW_ARCH=y
CONFIG_MTK_SND_SOC_CODEC="mt6351"
CONFIG_MTK_PMIC_WRAP_HAL=y

CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGER=y
CONFIG_INV_MPU_IIO=y
# CONFIG_DTS_INV_MPU_IIO is not set
CONFIG_MTK_SENSOR_SUPPORT=y
# CONFIG_MTK_SENSORS_1_0 is not set
CONFIG_MTK_M681_LEGACY_SENSORS=y
CONFIG_MTK_LTR579=y
CONFIG_MTK_PA12200001=y
CONFIG_MTK_AKM09911_NEW=y
CONFIG_MTK_ST480=y
CONFIG_MEIZU_SYSFS_CLASS=y
CONFIG_SPI=y
CONFIG_MTK_SPI=y
CONFIG_TRUSTONIC_TEE_SUPPORT=y
CONFIG_TRUSTONIC_TEE_VERSION="302c"
CONFIG_MOBICORE_DRIVER=y
CONFIG_MOBICORE_API=y
# CONFIG_TRUSTONIC_TRUSTED_UI is not set
CONFIG_MTK_FINGERPRINT_SUPPORT=y
CONFIG_MTK_FINGERPRINT_SELECT="GF516M"
CONFIG_GOODIX_FINGERPRINT=y
CONFIG_GOODIX_SENSOR_TYPE="GF516M"

CONFIG_MTK_CCCI_DEVICES=y
CONFIG_MTK_ECCCI_DRIVER=y
CONFIG_MTK_ECCCI_CLDMA=y
CONFIG_MTK_NET_CCMNI=y
CONFIG_MTK_MD1_SUPPORT=12
CONFIG_MTK_ECCCI_C2K=n
CONFIG_MTK_PMIC_WRAP_HAL=y

CONFIG_MTK_M681_CLKBUF=y

# CONFIG_TOUCHSCREEN_MTK_GT9XXTB_HOTKNOT is not set
