
config MTK_AKM09912
	bool "AKM09911 for MediaTek package"
	# forge (m5c 4.9): legacy hwmsen stack is mutually exclusive with
	# the 4.9-native sensors-1.0 framework (symbol/ABI collisions).
	depends on !MTK_SENSORS_1_0
	default n
	help
	  It support different magnetometer sensor.
          If this option is set,
	  it will support
          AKMD09911 magnetometer.
